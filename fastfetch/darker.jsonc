
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    "source": "/home/arianeve/Pictures/pffp/flame3.jpg",
    "height": 18,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },

  "display": {
    "separator": "  ",

"color": {
  "keys": "#A9C4E4",
  "output": "#FFFFFF",
  "separator": "#E8D8C3",
  "title": "#76503F"
},

    "key": {
      "width": 22
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{##76503F}{user-name}{#}@{##192B46}{host-name}{#}"
    },

    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "{##C19A62}󰍹  SYSTEM{#}"
    },
    {
      "type": "os",
      "key": "┃ ├─ OS",
      "keyColor": "#192B46"
    },
    {
      "type": "kernel",
      "key": "┃ ├─ Kernel",
      "keyColor": "#192B46"
    },
    {
      "type": "uptime",
      "key": "┃ ├─ Uptime",
      "keyColor": "#192B46"
    },
    {
      "type": "packages",
      "key": "┃ └─ Packages",
      "keyColor": "#192B46",
      "format": "{all} total"
    },

    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "{##C19A62}󰓅  HARDWARE{#}"
    },
    {
      "type": "cpu",
      "key": "┃ ├─ CPU",
      "keyColor": "#192B46"
    },
    {
      "type": "gpu",
      "key": "┃ ├─ GPU",
      "keyColor": "#192B46"
    },
    {
      "type": "memory",
      "key": "┃ ├─ Memory",
      "keyColor": "#192B46"
    },
    {
      "type": "disk",
      "key": "┃ └─ Disk (/)",
      "keyColor": "#192B46",
      "folders": ["/"]
    },

    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "{##C19A62}󰇄  DESKTOP{#}"
    },
    {
      "type": "shell",
      "key": "┃ ├─ Shell",
      "keyColor": "#192B46"
    },
    {
      "type": "wm",
      "key": "┃ ├─ WM",
      "keyColor": "#192B46"
    },
    {
      "type": "terminal",
      "key": "┃ └─ Terminal",
      "keyColor": "#192B46"
    },

    "break"
  ]
}
