
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    "source": "/run/media/arianeve/6ea47c08-bb80-4911-bdc2-b1d0802de51e/ppfp/Cropped/flame3.jpg",
    "height": 14,
    "width": 28,
    "padding": {
      "top": 2,
      "left": 6,
      "right": 2
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "#A7C4DD",
      "output": "#FFFFFF",
      "separator": "#F3EBDD",
      "title": "#F0D7A4"
    },
    "key": {
      "width": 22
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{##A77E62}{user-name}{#}@{##F3EBDD}{host-name}{#}"
    },

    "break",

    {
      "type": "custom",
      "key": " ",
      "format": "{##F0D7A4}󰍹  SYSTEM{#}"
    },
    {
      "type": "os",
      "key": "┃ ├─ OS",
      "keyColor": "#A7C4DD"
    },
    {
      "type": "kernel",
      "key": "┃ ├─ Kernel",
      "keyColor": "#A7C4DD"
    },
    {
      "type": "uptime",
      "key": "┃ ├─ Uptime",
      "keyColor": "#A7C4DD"
    },
    {
      "type": "packages",
      "key": "┃ └─ Packages",
      "keyColor": "#A7C4DD",
      "format": "{all} total"
    },

    "break",

    {
      "type": "custom",
      "key": " ",
      "format": "{##F0D7A4}󰓅  HARDWARE{#}"
    },
    {
      "type": "cpu",
      "key": "┃ ├─ CPU",
      "keyColor": "#A7C4DD",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "┃ ├─ GPU",
      "keyColor": "#A7C4DD",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "┃ ├─ Memory",
      "keyColor": "#A7C4DD"
    },
    {
      "type": "disk",
      "key": "┃ └─ Disk (/)",
      "keyColor": "#A7C4DD",
      "folders": ["/"]
    },

    "break",

    {
      "type": "custom",
      "key": " ",
      "format": "{##F0D7A4}󰇄  DESKTOP{#}"
    },
    {
      "type": "shell",
      "key": "┃ ├─ Shell",
      "keyColor": "#A7C4DD"
    },
    {
      "type": "wm",
      "key": "┃ ├─ WM",
      "keyColor": "#A7C4DD"
    },
    {
      "type": "terminal",
      "key": "┃ └─ Terminal",
      "keyColor": "#A7C4DD"
    },

    "break"
  ]
}
